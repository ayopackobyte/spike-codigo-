    await motor_pair.move_for_degrees(motor_pair.PAIR_1,198, -90, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 800,0, velocity=300)

    await motor.run_for_degrees(port.F, 110, 260)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, -900, 0, velocity=300)
    #voy a dejarlo al barco

    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 390, -90, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 180, 90, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 130, 0, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 180, -90, velocity=300)

    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 240, 0, velocity=300)
    await motor.run_for_degrees(port.F, -100, 270)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, -240, 0, velocity=300)
    
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 195, 90, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 78, 0, velocity=300)
    #tiempo de buscar los otros 2 
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 195, 90, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 945, 0, velocity=300)
    await motor.run_for_degrees(port.F, 110, 260)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, -330, 0, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 195, -90, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 650, 0, velocity=300)
    await motor.run_for_degrees(port.F, -110, 260)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, -1500, 0, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 195, 90, velocity=300)
    await motor.run_for_degrees(port.F, 110, 260)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 580, 0, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 195, 90, velocity=300)
    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 1900, 0, velocity=300)




runloop.run(main())
