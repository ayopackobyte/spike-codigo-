import runloop
from hub import port
import motor
import motor_pair
import color_sensor
import color
import force_sensor

async def main():
    motor_pair.pair(motor_pair.PAIR_1, port.C, port.D)

    motor_pair.move(motor_pair.PAIR_1, 0, velocity=300)

    while color_sensor.color(port.B) != color.WHITE:
        await runloop.sleep_ms(10)

    motor_pair.stop(motor_pair.PAIR_1)
    await runloop.sleep_ms(2000)

    motor_pair.move(motor_pair.PAIR_1, 0, velocity=-200)

    while not force_sensor.force(port.E):
        await runloop.sleep_ms(10)

    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 900,  0 , velocity=300)

    await motor_pair.move_for_degrees(motor_pair.PAIR_1, 198, 90, velocity=300)

